# Copy this file to ".env" and fill in ONE provider.

# Which LLM to use: gemini | anthropic | openai | mock
# "mock" needs no API key and returns a canned demo result (good for a first run).
LLM_PROVIDER=gemini

# Google Gemini (key from https://aistudio.google.com/api-keys)
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.6-flash

ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini

# Safety limits for input size (characters)
MIN_TRANSCRIPT_CHARS=50
MAX_TRANSCRIPT_CHARS=60000
